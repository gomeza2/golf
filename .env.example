PORT=3001
# Production origin, comma separated. Empty permits same-origin only in production.
CLIENT_ORIGIN=http://localhost:5173
# Leave blank for same-origin (Vite proxies /socket.io in development).
VITE_SERVER_URL=
MAX_PLAYERS=8

# GitHub Pages builds (set by the publication workflow):
# PAGES_BASE_PATH=/golf/
# VITE_STATIC_HOST=true
