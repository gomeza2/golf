PORT=3001
# Additional allowed browser origins, comma separated; the server own origin is automatic.
CLIENT_ORIGIN=http://localhost:5173
# Leave blank for same-origin (Vite proxies /socket.io in development).
VITE_SERVER_URL=
MAX_PLAYERS=8

