PORT=3001
# Additional allowed browser origins, comma separated; the server own origin is automatic.
CLIENT_ORIGIN=http://localhost:5173
# Leave blank for same-origin (Vite proxies /socket.io in development).
VITE_SERVER_URL=
MAX_PLAYERS=8
DISCONNECT_GRACE_SECONDS=90

# GitHub Pages builds (set by the publication workflow):
# PAGES_BASE_PATH=/golf/
# VITE_STATIC_HOST=true

# Optional persistent community. Empty keeps community disabled; the game still works.
# Server-only connection to PostgreSQL. Use provider TLS verification and real credentials.
COMMUNITY_DATABASE_URL=
# Optional, exact true: prepare a missing schema on startup (e.g. Render Free without shell).
# No accounts or sample creations are inserted. Failure keeps only community unavailable.
COMMUNITY_MIGRATE_ON_START=false
# Public OIDC client with Authorization Code + PKCE, signed JWT access tokens for this API.
COMMUNITY_OIDC_ISSUER=
COMMUNITY_OIDC_CLIENT_ID=
COMMUNITY_OIDC_AUDIENCE=
COMMUNITY_OIDC_JWKS_URL=
COMMUNITY_OIDC_SCOPE=openid profile
# Exact verified `sub` values, comma-separated. No client-provided roles are trusted.
COMMUNITY_MODERATOR_SUBJECTS=
# Trusted ingress hops: 0 locally, normally 1 behind Render's sole ingress proxy.
COMMUNITY_TRUST_PROXY_HOPS=0
# Optional build-time trusted community API origin (never a database URL or token).
# Pages defaults to its configured VITE_SERVER_URL/public Render server; Node uses same origin.
VITE_COMMUNITY_SERVER_URL=
# Dedicated LOCAL test database only. Never point this at production.
# TEST_COMMUNITY_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/golf_test
