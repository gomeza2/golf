{
  "name": "hoyo-en-uno-golf-club",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --import tsx --watch server/dev.ts",
    "build": "tsc --noEmit && vite build && esbuild server/start.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js && esbuild scripts/migrate-community.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/migrate-community.js && esbuild scripts/check-community.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/check-community.js",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:online": "playwright test --config=playwright.online.config.ts",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "community:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-community.ts",
    "community:migrate:production": "node --env-file-if-exists=.env dist-server/migrate-community.js",
    "test:community": "vitest run --config vitest.community.config.ts",
    "test:community:e2e": "playwright test --config=playwright.community.config.ts",
    "community:check": "node --env-file-if-exists=.env --import tsx scripts/check-community.ts",
    "community:check:production": "node --env-file-if-exists=.env dist-server/check-community.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@react-three/fiber": "^9.4.0",
    "jose": "^6.2.15",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
